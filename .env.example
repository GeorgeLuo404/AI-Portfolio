# Copy to .env.local and fill in. Never commit real values: .env.local is
# ignored by git, and this file is public.

# DeepSeek API key for the AI twin chat (T9). Create one at
# https://platform.deepseek.com/api_keys. It's read on the server only, so it
# must never use the NEXT_PUBLIC_ prefix.
DEEPSEEK_API_KEY=

# The DeepSeek model for the chat. Leave empty for deepseek-flash.
DEEPSEEK_MODEL=

# Turns the AI twin on with "true". Off by default. The page reads it while
# the site builds, so changing it takes a redeploy.
CHAT_ENABLED=
